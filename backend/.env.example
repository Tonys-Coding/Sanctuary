# ─── Sanctuary · configuración del servidor ────────────────────────────────
# Copia este archivo como ".env" y rellena los valores.
# Copy this file to ".env" and fill in the values.

# Base de datos PostgreSQL / PostgreSQL database
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/sanctuary

# Clave secreta para las sesiones (una frase larga y aleatoria)
# Secret used to sign sessions (use a long random string)
JWT_SECRET=cambia-esta-frase-por-una-larga-y-secreta

PORT=5001
# Dirección pública de la aplicación (se usa en los enlaces de los correos)
# Public address of the app (used for links inside e-mails)
APP_URL=http://localhost:5173

# ─── Inteligencia artificial (Google Gemini) ───────────────────────────────
# Pega aquí tu clave y reinicia el servidor. Eso es todo.
# Paste your key here and restart the server. That's all.
# Consíguela en / Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ─── Correo (SMTP) — para restablecer contraseñas y enviar informes ────────
# Sin esto, los enlaces de restablecimiento se muestran en la consola del servidor.
# Without this, password-reset links are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sanctuary <tesoreria@tu-iglesia.org>"

# ─── Mensajes de texto (SMS) con Twilio — opcional ─────────────────────────
# Crea una cuenta en https://www.twilio.com, compra un número y copia estos datos.
# Cada mensaje cuesta alrededor de 1 centavo. Solo se envían a miembros que aceptaron recibirlos.
# Text messages through Twilio (optional). Only members who agreed to receive texts get them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Código de país para números sin "+" (1 = EE. UU. y Canadá, 52 = México)
SMS_DEFAULT_COUNTRY_CODE=1
